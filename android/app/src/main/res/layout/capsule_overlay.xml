<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/capsule_bg"
    android:gravity="center_vertical"
    android:minWidth="180dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/capsule_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginEnd="9dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/capsule_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:maxWidth="180dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/capsule_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="180dp"
            android:textColor="#B3FFFFFF"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/capsule_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="52dp"
        android:layout_height="4dp"
        android:layout_marginStart="10dp"
        android:progressBackgroundTint="#2EFFFFFF"
        android:progressTint="#B79CFF"
        android:visibility="gone" />
</LinearLayout>
